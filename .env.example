# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=your_typesafe_key_here       # from console.typesafe.ai
WANDB_API_KEY=your_wandb_key_here             # also authenticates the W&B Inference baseline

# optional overrides
RUNTIME_ARM=typesafe                          # or: baseline
BASELINE_MODEL=meta-llama/Llama-3.1-8B-Instruct   # a W&B Inference model id
WANDB_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
WANDB_INFERENCE_PROJECT=your-entity/your-project  # required for W&B Inference usage tracking
