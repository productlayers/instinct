# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=your_typesafe_key_here       # from console.typesafe.ai
WANDB_API_KEY=your_wandb_key_here
OPENROUTER_API_KEY=your_openrouter_key_here   # baseline arm (LLM-as-judge, via OpenRouter)

# optional overrides
RUNTIME_ARM=typesafe                          # or: baseline
BASELINE_MODEL=openai/gpt-4o-mini             # any OpenRouter model id
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
